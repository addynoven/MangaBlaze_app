generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth v5 required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  userName       String?   @unique
  role           String    @default("user")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  malToken       String?
  anilistToken   String?
  trackerSyncEnabled Boolean @default(true)

  accounts       Account[]
  sessions       Session[]
  bookmarks      Bookmark[]
  readingProgress ReadingProgress[]
}

// Cached manga metadata from various sources
model Manga {
  id          String   @id // Unique ID (could be sourceId:mangaId)
  sourceId    String   @default("mangadex")
  realId      String   // Original ID from the source
  title       String
  description String?
  status      String?  // ongoing, completed, hiatus, cancelled
  year        Int?
  contentRating String? // safe, suggestive, erotica, pornographic
  originalLanguage String?
  coverUrl    String?
  tags        String?  // JSON array of tag names
  authors     String?  // JSON array of author names
  chapters    Chapter[]
  bookmarks   Bookmark[]
  readingProgress ReadingProgress[]
  cachedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceId, realId])
}

// Cached chapter metadata
model Chapter {
  id          String   @id // Unique chapter ID
  sourceId    String   @default("mangadex")
  realId      String   // Original chapter ID from source
  mangaId     String
  manga       Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapterNumber String?  // e.g. "1", "1.5", "extra-1"
  title       String?
  volume      String?
  pages       Int      @default(0)
  language    String   @default("en")
  publishedAt DateTime?
  cachedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  readingProgress ReadingProgress[]

  @@unique([sourceId, realId])
  @@index([mangaId])
}

// User bookmarks
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId   String
  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  status    String   @default("reading") // reading, plan_to_read, completed, on_hold, dropped
  createdAt DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([userId])
  @@index([mangaId])
}

// Real-time health and performance of manga sources
model SourceHealth {
  sourceId    String   @id
  status      String   @default("online") // online, offline, slow
  lastLatency Int      @default(0)       // in milliseconds
  errorCount  Int      @default(0)
  lastError   String?
  lastChecked DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Reading progress per manga
model ReadingProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId         String
  manga           Manga     @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapterId       String?
  chapter         Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  pageIndex       Int       @default(1)
  chapterNumber   String?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, mangaId])
  @@index([userId])
  @@index([mangaId])
}
